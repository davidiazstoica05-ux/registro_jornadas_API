### GET all departments
GET http://localhost:8080/api/v1/department

### GET a department by id
GET http://localhost:8080/api/v1/department/1

### GET a department that does not exist (404)
GET http://localhost:8080/api/v1/department/999

### POST a new department (201)
POST http://localhost:8080/api/v1/department
Content-Type: application/json

{
  "name": "Videojuegos",
  "budget": 10000
}

### Error 1: POST without name (400)
POST http://localhost:8080/api/v1/department
Content-Type: application/json

{
  "name": "",
  "budget": 1000
}

### Error 2: POST with a negative budget (400)
POST http://localhost:8080/api/v1/department
Content-Type: application/json

{
  "name": "Videojuegos",
  "budget": -1
}

### Error 3: POST with a negative budget and an empty name (400, two errors)
POST http://localhost:8080/api/v1/department
Content-Type: application/json

{
  "name": "",
  "budget": -1
}

### PUT edit a department (200)
PUT http://localhost:8080/api/v1/department/1
Content-Type: application/json

{
  "name": "Videojuegos2",
  "budget": 150.0
}

### Error: PUT with an empty name (400)
PUT http://localhost:8080/api/v1/department/1
Content-Type: application/json

{
  "name": "",
  "budget": 150.0
}

### Error: PUT with a negative budget (400)
PUT http://localhost:8080/api/v1/department/1
Content-Type: application/json

{
  "name": "Videojuegos2",
  "budget": -5
}

### Error: PUT a department that does not exist (404)
PUT http://localhost:8080/api/v1/department/999
Content-Type: application/json

{
  "name": "Nuevo",
  "budget": 100.0
}

### DELETE a department (204)
DELETE http://localhost:8080/api/v1/department/1

### Error: DELETE a department that does not exist (404)
DELETE http://localhost:8080/api/v1/department/999

### EMPLOYEES REQUESTS

### GET all employees (200)
GET http://localhost:8080/api/v1/employee

### GET an employee by id (200)
GET http://localhost:8080/api/v1/employee/1

### Error: GET an employee that does not exist (404)
GET http://localhost:8080/api/v1/employee/999

### Error: GET with an invalid id (400)
GET http://localhost:8080/api/v1/employee/0

### POST a new employee (201)
POST http://localhost:8080/api/v1/employee
Content-Type: application/json

{
  "fullName": "Ana Pérez",
  "position": "Developer",
  "salary": 2500.00,
  "departmentId": 1
}

### POST an employee without a department (201, department is optional)
POST http://localhost:8080/api/v1/employee
Content-Type: application/json

{
  "fullName": "Luis García",
  "position": "Intern",
  "salary": 1200.00
}

### Error: POST with an empty full name (400)
POST http://localhost:8080/api/v1/employee
Content-Type: application/json

{
  "fullName": "",
  "position": "Developer",
  "salary": 2500.00,
  "departmentId": 1
}

### Error: POST with only one word as the name (400, if you use the regex)
POST http://localhost:8080/api/v1/employee
Content-Type: application/json

{
  "fullName": "Ana",
  "position": "Developer",
  "salary": 2500.00,
  "departmentId": 1
}

### Error: POST with an empty position (400)
POST http://localhost:8080/api/v1/employee
Content-Type: application/json

{
  "fullName": "Ana Pérez",
  "position": "",
  "salary": 2500.00,
  "departmentId": 1
}

### Error: POST with a negative salary (400)
POST http://localhost:8080/api/v1/employee
Content-Type: application/json

{
  "fullName": "Ana Pérez",
  "position": "Developer",
  "salary": -100,
  "departmentId": 1
}

### Error: POST without salary (400)
POST http://localhost:8080/api/v1/employee
Content-Type: application/json

{
  "fullName": "Ana Pérez",
  "position": "Developer",
  "departmentId": 1
}

### Error: POST with several wrong fields (400, several errors)
POST http://localhost:8080/api/v1/employee
Content-Type: application/json

{
  "fullName": "",
  "position": "",
  "salary": -1
}

### Error: POST with a department that does not exist (404)
POST http://localhost:8080/api/v1/employee
Content-Type: application/json

{
  "fullName": "Ana Pérez",
  "position": "Developer",
  "salary": 2500.00,
  "departmentId": 999
}

### Error: POST with a malformed JSON (400)
POST http://localhost:8080/api/v1/employee
Content-Type: application/json

{
  "fullName": "Ana Pérez",
  "salary":
}

